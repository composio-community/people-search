# The agent runs through OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id
AGENT_MODEL=deepseek/deepseek-v4.1-flash

# 32+ random characters that encrypt the session cookie, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Optional overrides
# COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# APP_URL=http://localhost:3000
