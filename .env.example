# Model provider: an OpenRouter key runs the agent on AGENT_MODEL through
# OpenRouter's Anthropic-compatible endpoint. Without it, ANTHROPIC_API_KEY
# runs Claude Opus 5.5 directly.
OPENROUTER_API_KEY=
AGENT_MODEL=deepseek/deepseek-v4.1-flash
# ANTHROPIC_API_KEY=
# CLAUDE_EFFORT=medium  (Claude models only)

# 32+ random chars used to encrypt the session cookie
SESSION_SECRET=

# Optional overrides
# COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# APP_URL=http://localhost:3000
